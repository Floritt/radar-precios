Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fuerza HTTPS (coméntalo si tu dominio aún no tiene certificado SSL)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Carpetas internas: nunca accesibles desde el navegador
    RewriteRule ^(app|cron|storage|content)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(config\.php|config\.example\.php|README\.md|\.gitignore)$ - [F,L]

    # Archivos reales (CSS, JS, imágenes, instalador) se sirven tal cual
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás pasa por index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|png|jpg|jpeg|webp|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
